{
  "name": "agent-recall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first MCP memory server for coding agents.",
  "bin": {
    "agent-recall": "./dist/bin/agent-recall.js",
    "agent-recall-mcp": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "cli": "tsx bin/agent-recall.ts",
    "cli:doctor": "tsx bin/agent-recall.ts doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}

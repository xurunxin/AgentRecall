# agent-recall HTTP bridge — configuration template
# ----------------------------------------------------
# Copy this file to `dist-bin/.env` (next to the binary)
# and fill in the values for your host.  The bridge
# reads it at startup; later changes require restarting
# the bridge.
#
# Format: standard .env (KEY=VALUE, # comments).
# JSON object form (`{"KEY":"VALUE"}`) is also accepted
# if you prefer, but the .env form is more standard
# for an exe-side config.
#
# Precedence (highest to lowest):
#   1) AGENT_RECALL_BRIDGE_ENV_FILE  — explicit path override
#   2) <exe-dir>/.env                — this file
#   3) <exe-dir>/.bridge.env         — JSON variant
#   4) <__dirname>/.bridge.env       — dev mode (node bridge.mjs)
# After loading, the values OVERRIDE whatever was
# already in process.env (dotenv semantics).

# --- Required ---

# Absolute path to the data home (contains memory.sqlite,
# exports/, backups/, schema_version, etc.).
# Default: ~/.agent-recall
# Example: G:\Memory\AgentRecall
AGENT_RECALL_HOME=

# Which tool surface the bridge exposes.
#   core      — safe low-surface default
#   extended  — adds memory-semantics + admin tools (most common)
#   admin     — same surface as extended, but requires an
#               operator capability file; see agent-recall admin grant
# Default: extended
AGENT_RECALL_PROFILE=extended

# Default actor recorded on writes when the caller doesn't
# supply one.  Pick a stable per-machine identity; common
# choices:
#   agent:shared-memory   (one bridge serving many MCP clients)
#   agent:claude-code     (if only Claude Code uses this bridge)
#   agent:<user>:<host>   (per-user, per-host)
# Default: agent:http-bridge
AGENT_RECALL_ACTOR=agent:shared-memory

# TCP port the bridge listens on.  Use 127.0.0.1 unless
# you trust the LAN (no auth on the bridge itself by default).
# Default: 7777
MCP_HTTP_PORT=7781

# --- Optional ---

# Silence the "[agent-recall] the binary is now the CLI" deprecation
# notice.  Strongly recommended so the bridge's stderr log stays clean.
AGENT_RECALL_SUPPRESS_MCP_DEPRECATION=1

# 1 = log every MCP request (initialize / tools/list / tools/call / etc.)
# to stderr.  Useful for debugging; noisy in production.
# AGENT_RECALL_VERBOSE=0

# 1 = emit "connected on stdio" hint at startup; the bridge
# doesn't use stdio but the underlying service still emits
# it on some profile transitions.
# AGENT_RECALL_VERBOSE_STDIO=0

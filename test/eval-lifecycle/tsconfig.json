{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "../../dist/test/eval-lifecycle",
    "rootDir": ".",
    "baseUrl": "../..",
    "paths": {
      "@agent-recall/contracts": [
        "./dist/packages/contracts/dist/index.d.ts",
        "./dist/packages/contracts/dist/index.js"
      ]
    },
    "types": ["node"]
  },
  "include": [
    "runner.ts",
    "runner-cli.ts",
    "schemas.ts",
    "report.ts",
    "index.ts"
  ],
  "exclude": ["fixtures"]
}

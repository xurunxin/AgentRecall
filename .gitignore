# Build artefacts
node_modules/
dist/
dist-bin/
coverage/

# Lifecycle evaluation harness output (issue #55)
artifacts/eval-lifecycle/

# pnpm lockfile (the project uses npm; pnpm-lock is
# generated by sub-agent installers and must NOT be
# checked in)
pnpm-lock.yaml

# Local data homes (legacy + current naming)
.local-memory-mcp/
.agent-recall/

# SQLite sidecars that the live database grows
# alongside. These are *not* the database itself
# (memory.sqlite) but its write-ahead log + shared
# memory file. They must be excluded so the
# database-only backup copies cleanly; left in
# place they create spurious git diffs whenever
# the live DB is touched.
*.sqlite-wal
*.sqlite-shm

# Pre-restore backup artefacts produced by
# `agent-recall restore --confirm`. They sit next
# to `memory.sqlite` in the data home and are
# named `memory.sqlite.pre-restore.<ts>`.
memory.sqlite.pre-restore.*

# Test scratch directories created by the
# portability / import tests. They are produced
# under the system temp dir (tmpdir()) so the
# gitignore is a belt-and-suspenders safety net
# in case a test ever writes into the repo root.
tmp-*
.tmp/

# Verbose log files
*.log

# Editor / OS scratch
.vscode/
.idea/
.DS_Store
Thumbs.db

# Per-PR worktrees (the CI matrix runs in a clean
# checkout, but local development uses git
# worktree add under .worktrees/).
.worktrees/

# Local-only memory-mcp scratch (the agent runs
# its own .codegraph + similar tools here).
.codegraph/


# http-bridge debug / runtime logs
http-bridge/binary.err
http-bridge/binary.out
http-bridge/node.err
http-bridge/node.out
binary.err
binary.out
node.err
node.out

# bridge binary test scratch (deleted after commits)
/.bridge-test-scratch/

# bridge binary env (machine-specific paths; copy from http-bridge/.env.example)
/dist-bin/.env


# scratch (one-off diagnostic outputs)
/all-tasks.txt
/git-tree.txt


# one-off diagnostic captures from MCP-config hunting
/mcp-config-before.json
/http-bridge/find-mcp-config.py

# Tauri (apps/admin/src-tauri) build artefacts.
# The Tauri CLI regenerates `gen/` on every build (it
# holds `tauri-build` macro output and the capability
# schema snapshots), and `cargo` writes the standard
# Rust build dir under `target/`. Neither is source.
# Scoped to the admin Tauri app so a future `target/`
# under another crate (e.g. a future shared `packages/`
# Rust lib) is not silently swallowed.
apps/admin/src-tauri/gen/
apps/admin/src-tauri/target/

# Tauri-built application binary. The CI release
# pipeline produces this in dist/ and uploads it from
# there; the local debug build drops it at the repo
# root and must not be tracked.
agent-recall.exe

# Stale `src/**/*.js` siblings of `*.ts` source files.
# The project's `tsconfig.json` includes only `*.ts`
# and emits to `dist/`, so any .js sitting next to a
# .ts in `src/` is by definition a stray transpile
# artefact (or a one-off diagnostic output) — never
# project source. Real JS lives under `dist/` after
# `npm run build`.
src/**/*.js

# TypeScript incremental build cache. `tsc --incremental`
# drops a `<tsconfig>.tsbuildinfo` next to each
# tsconfig.json; they are pure rebuild-skip metadata
# and must not be tracked.
*.tsbuildinfo

# Backup files (mostly `*.bak` rotated by the local
# Tauri debug-build pipeline, which renames the
# previous `agent-recall*.exe` to `*.vN.bak` before
# overwriting). Hundreds of MB each; never source.
*.bak

# Demo / scratch data homes produced by the eval
# harness and ad-hoc reproductions. Sibling of the
# already-ignored `.local-memory-mcp/` and
# `.agent-recall/`. Holds the bulky `agent-recall-*.bak`
# binaries plus the per-eval `report.json` / `report.md`
# and the eval runner copies. Regenerable from scripts.
.demo-data-home/

